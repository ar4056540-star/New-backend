# Required in production: use a long, random secret (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
PORT=3000
# For persistent hosting, point this to the mounted persistent disk path.
DATA_DIR=/var/data
# Optional: set to your exact frontend origin if cross-origin browser access is needed.
# CORS_ORIGIN=https://your-frontend.example.com
# Optional upload cap in megabytes (default 512).
TSUKYO_MAX_UPLOAD_MB=512

# --- Push notifications (Firebase Cloud Messaging, HTTP v1) ---
# Paste the full service-account JSON (single line) from Firebase Console > Project settings > Service accounts.
# Alternatively set FCM_SERVICE_ACCOUNT_FILE to the path of the JSON file on the persistent disk.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/var/data/firebase-service-account.json
# Set to "false" to reject legacy base64 image uploads from the old web client.
# TSUKYO_ALLOW_DATA_URLS=true
